; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tag Force Special"
run/main_scene="res://Scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=960
window/size/viewport_height=544

[dotnet]

project/assembly_name="TagForceSpecial.PC"
project/solution_directory=".."

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=false
textures/canvas_textures/default_texture_filter=0
