  <ScreenReference Name="OriginalDeckMenu" />
  <ScreenReference Name="OriginalDeckEdit" />
  <ScreenReference Name="OriginalFreeDuel" />
  <ScreenReference Name="OriginalStorySelection" />
  <ScreenReference Name="OriginalStoryDialogue" />
  <ComponentReference Name="OriginalMenuBar" />
  <ComponentReference Name="OriginalOptionRow" />
  <ComponentReference Name="OriginalChoiceDialog" />
  <ComponentReference Name="OriginalDialogButton" />
  <ComponentReference Name="OriginalCardDetail" />
  <ComponentReference Name="OriginalScrollBar" />
  <ComponentReference Name="OriginalTextBox" />
  <ComponentReference Name="OriginalStatusPanel" />
  <ComponentReference Name="CardInfoPanel" />
  <ComponentReference Name="DeckCounts" />
  <ComponentReference Name="DeckSectionTabs" />
  <ComponentReference Name="DeckCardList" />
  <StandardElementReference Name="Circle" />
