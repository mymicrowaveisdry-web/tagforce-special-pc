<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>OriginalStatusPanel</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">456</Value>
    </Variable>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">32</Value>
    </Variable>
    <Variable Type="float" Name="Status.X" SetsValue="true">
      <Value xsi:type="xsd:float">8</Value>
    </Variable>
    <Variable Type="float" Name="Status.Y" SetsValue="true">
      <Value xsi:type="xsd:float">4</Value>
    </Variable>
    <Variable Type="float" Name="Status.Width" SetsValue="true">
      <Value xsi:type="xsd:float">430</Value>
    </Variable>
    <Variable Type="float" Name="Status.Height" SetsValue="true">
      <Value xsi:type="xsd:float">22</Value>
    </Variable>
    <Variable Type="GeneralUnitType" Name="Status.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="GeneralUnitType" Name="Status.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Status.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Status.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="Status.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="Status.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="string" Name="Status.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Original measurements pending</Value>
    </Variable>
    <Variable IsFont="true" Type="string" Name="Status.Font" SetsValue="true">
      <Value xsi:type="xsd:string">Fonts/LiberationSans-Regular.ttf</Value>
    </Variable>
    <Variable Type="int" Name="Status.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">12</Value>
    </Variable>
  </State>
  <Instance Name="Status" BaseType="Text" />
</ComponentSave>