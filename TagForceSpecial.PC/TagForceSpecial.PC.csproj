<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- The Godot game host. Folders holding a .gdignore are the MonoGame/Gum presentation awaiting its Godot port; they still compile
       (hence the two legacy packages) but Godot neither imports their assets nor treats them as scripts. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TagForceSpecial.Workbench\TagForceSpecial.Workbench.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="Gum.MonoGame" Version="2026.11.2.1" />
  </ItemGroup>

  <Target Name="BundleImporterWorkbench" AfterTargets="Build">
    <ItemGroup>
      <WorkbenchFiles Include="..\TagForceSpecial.Workbench\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkbenchFiles)" DestinationFiles="@(WorkbenchFiles->'$(TargetDir)workbench\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="UI\Gum\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="App\Screens\Title\title-frame.json" />
    <EmbeddedResource Include="App\Screens\Title\options-frame.json" />
    <EmbeddedResource Include="App\Screens\Title\deck-menu-frame.json" />
    <EmbeddedResource Include="App\Screens\Title\database-menu-frame.json" />
    <EmbeddedResource Include="App\Screens\Album\card-album-detail.json" />
    <EmbeddedResource Include="App\Screens\FreeDuel\free-duel-versus-frame.json" />
    <EmbeddedResource Include="App\Screens\FreeDuel\free-duel-decks-frame.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TagForceSpecial.App\TagForceSpecial.App.csproj" />
    <ProjectReference Include="..\TagForceSpecial.AI\TagForceSpecial.AI.csproj" />
    <ProjectReference Include="..\TagForceSpecial.Assets\TagForceSpecial.Assets.csproj" />
    <ProjectReference Include="..\TagForceSpecial.Cards\TagForceSpecial.Cards.csproj" />
    <ProjectReference Include="..\TagForceSpecial.Core\TagForceSpecial.Core.csproj" />
    <ProjectReference Include="..\TagForceSpecial.Effects\TagForceSpecial.Effects.csproj" />
    <ProjectReference Include="..\TagForceSpecial.Import\TagForceSpecial.Import.csproj" />
  </ItemGroup>
</Project>
