{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "functions",
    "workUnits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "sourceSha256",
          "address",
          "length",
          "subsystem",
          "classification",
          "boundaryConfidence",
          "status",
          "provenance",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[A-Fa-f0-9]{8}$"
          },
          "length": {
            "type": "integer",
            "minimum": 4,
            "multipleOf": 4
          },
          "subsystem": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "unknown",
              "game",
              "crt",
              "sdk"
            ]
          },
          "boundaryConfidence": {
            "type": "string",
            "enum": [
              "candidate",
              "corroborated"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "discovered",
              "classified",
              "under-investigation",
              "implemented",
              "behavior-verified",
              "comparison-blocked",
              "comparison-differs",
              "psp-byte-matched"
            ]
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "availability",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^/]+(?:/[^/]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "availability": {
                  "type": "string",
                  "enum": [
                    "committed",
                    "local"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "static-analysis",
                    "runtime-capture",
                    "fixture",
                    "test",
                    "comparison",
                    "source"
                  ]
                }
              }
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "workUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "functionId",
          "dependsOn",
          "outputs",
          "validationCommand"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "analysis",
              "native",
              "behavior"
            ]
          },
          "functionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^/]+(?:/[^/]+)*$"
            },
            "minItems": 1
          },
          "validationCommand": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Function research queue"
}
