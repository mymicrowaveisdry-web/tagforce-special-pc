{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "scopeVersion",
          "denominator",
          "reason",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scopeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "denominator": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status",
                "module",
                "sourceSha256",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "accepted",
                    "historical"
                  ]
                },
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "availability",
                      "kind"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^/]+(?:/[^/]+)*$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[A-Fa-f0-9]{64}$"
                      },
                      "availability": {
                        "type": "string",
                        "enum": [
                          "committed",
                          "local"
                        ]
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "static-analysis",
                          "runtime-capture",
                          "fixture",
                          "test",
                          "comparison",
                          "source"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned functional coverage scopes"
}
